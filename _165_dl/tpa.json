<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>登入 - 多商户客服系统</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="/static/admin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="/static/admin/style/admin.css" media="all">
    <link rel="stylesheet" href="/static/admin/style/login.css" media="all">
</head>

<body>

    <div class="loginMain" id="LAY-user-login">
        <!-- 内容 -->
        <div class="loginConten">
            <!-- 左 -->
            <div class="loginLeft">
                <div class="leftText">
                    <p class="title">多商户客服系统 - 总控制台</p>
                    <p class="tip">版本号 v1.0.0</p>
                </div>
            </div>

            <!-- 右 -->
            <div class="loginRight">
                <div class="loginBox">
                    <div class="userTit">
                        <p class="name">管理员登录</p>
                        <div class="line"></div>
                    </div>

                    <form method="post" onsubmit="return false;">

                        <!-- 1 -->
                        <div class="userFrom" style="padding-top: 40px;">
                            <p class="accountTxt"> <i class="layui-icon  layui-icon-friends" style="font-size: 14px;margin-right: 4px;"></i> 管理账号</p>
                            <input type="text" name="username" id="LAY-user-login-username" lay-verify="required" placeholder="请输入账号" class="account">
                        </div>

                        <!-- 2 -->
                        <div class="userFrom" style="padding-top: 18px ;">
                            <p class="accountTxt"> <i class="layui-icon  layui-icon-link" style="font-size: 14px;margin-right: 4px;"></i> 管理密码</p>
                            <input type="password" name="password" id="LAY-user-login-password" lay-verify="required" placeholder="请输入账号" class="account">
                        </div>

                        <!-- 3 -->
                        <div class="userFrom" style="padding-top: 18px ;">
                            <p class="accountTxt"> <i class="layui-icon  layui-icon-fonts-strong" style="font-size: 14px;margin-right: 4px;"></i> 验证码</p>
                            <input type="text" name="verify" id="LAY-user-login-vercode" lay-verify="required" placeholder="图形验证码" class="account verify">
                            <img src="/customer/admin/verify.html" class="verifys" id="verify" onclick="this.src='/customer/admin/verify.html?seed='+Math.random()">
                        </div>

                        <!-- submit -->
                        <button class="userBtn" lay-submit onclick="return check();">登陆</button>
                    </form>
                </div>
            </div>

        </div>

    </div>

    <script src="/static/admin/layui/layui.js"></script>
    <script>
        layui.use(['layer', 'form'], function() {

        })

        function check() {
            var url = "/customer/admin/dologin.html";
            var load = layer.load(2);
            var $ = layui.$;
            $.post(url, $("form").serialize(), function(data) {
                console.log($("form").serialize())
                if (data.status == 1) {
                    layer.msg(data.msg, {
                        icon: 1,
                        time: 1000
                    }, function() {
                        location.href = "/customer/admin/index.html";
                    });
                } else {
                    layer.msg(data.msg, {
                        icon: 2,
                        time: 1500
                    }, function() {
                        layer.close(load);
                        $("#verify").click();
                    });
                }
            })
        }
    </script>
